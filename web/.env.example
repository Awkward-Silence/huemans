# "mock" runs the whole flow in the browser; "http" talks to the api/ app.
VITE_API_MODE=mock
VITE_API_URL=http://localhost:3000
# Event the demo link opens. Leave empty for the mock ("demo"); with VITE_API_MODE=http, run
# `pnpm seed:demo` in api/ and set it to 0199c0de-0000-7000-8000-000000000001.
VITE_DEMO_EVENT_ID=
# Theme picked when there is no ?theme= in the URL (see src/theme/themes).
VITE_DEFAULT_THEME=default
