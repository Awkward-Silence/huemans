PORT=3000
DATABASE_URL=postgresql://huemans:huemans@localhost:5432/huemans
# Origin allowed to call the API from a browser (the web app). '*' is fine: the API is anonymous.
CORS_ORIGIN=*
# Optional. Without a key GET /sentence-tree answers 503 and web/ falls back to its bundled tree.
OPENAI_API_KEY=
# gpt-4.1-mini and gpt-4.1 ignore the tree's 3-option shape; gpt-5-mini follows it.
OPENAI_MODEL=gpt-5-mini
# minimal | low | medium | high: more effort, slower generation.
OPENAI_REASONING_EFFORT=low
# Set to false to generate the sentence tree on the first request instead of at boot.
SENTENCE_TREE_ON_BOOT=true
