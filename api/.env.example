PORT=3000
DATABASE_URL=postgresql://huemans:huemans@localhost:5432/huemans
# Origin allowed to call the API from a browser (the web app). '*' is fine: the API is anonymous.
CORS_ORIGIN=*
# Put real keys in .env.local (.env.test.local for tests), not here: those win over .env and are git-ignored.
# Optional. Claude writes the "I ..." sentence tree; without a key GET /sentence-tree answers 503 and web/ falls back to its bundled tree.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to false to generate the sentence tree on the first request instead of at boot.
SENTENCE_TREE_ON_BOOT=true
# Optional. Jev weighs the traits of the "I ..." sentence on submit; without a key the sentence adds no traits.
JEV_API_KEY=
JEV_MODEL=jev-latest
# Past this the sentence is skipped and the multiple-choice answers decide alone.
JEV_TIMEOUT_MS=1500
