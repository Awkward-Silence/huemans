{
  "name": "huemans-api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/apps/api/apps/api/src/main",
    "lint": "eslint \"{apps,src,tests}/**/*.ts\"",
    "format": "prettier --write \"{apps,src,tests}/**/*.ts\"",
    "test": "jest",
    "test:unit": "jest --selectProjects Unit",
    "test:integration": "jest --selectProjects Integration",
    "test:functional": "jest --selectProjects Functional",
    "migration:create": "dotenv -e .env -- mikro-orm migration:create",
    "migration:up": "dotenv -e .env -- mikro-orm migration:up",
    "migration:up:test": "dotenv -e .env.test -- mikro-orm migration:up"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./src/Shared/Infrastructure/Persistence/MikroOrm/mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@mikro-orm/core": "^6.6.1",
    "@mikro-orm/migrations": "^6.6.1",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.6.1",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@mikro-orm/cli": "^6.6.1",
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.1",
    "@types/supertest": "^6.0.3",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
