classDiagram
  class Question {
    <<AggregateRoot>>
    +QuestionId id
    +Theme theme
    +QuestionText text
    +AnswerCollection answers
    +author(QuestionId id, Theme theme, QuestionText text, AnswerCollection answers) QuestionAuthored
  }

  class Answer {
    +AnswerId id
    +AnswerText text
    +SK~Trait~ trait
  }

  class AnswerCollection {
    <<Collection>>
  }

  class Icebreaker {
    <<AggregateRoot>>
    +IcebreakerId id
    +Theme theme
    +IcebreakerText text
    +IcebreakerTraitCollection traits
    +author(IcebreakerId id, Theme theme, IcebreakerText text, IcebreakerTraitCollection traits) IcebreakerAuthored
  }

  class IcebreakerTraitCollection {
    <<Collection>>
  }

  class PersonalityTypes {
    <<AggregateRoot>>
    +TraitTypeMapping mapping
    +PersonalityTypeProfileCollection profiles
    +define(TraitTypeMapping mapping, PersonalityTypeProfileCollection profiles) PersonalityTypesDefined
  }

  class PersonalityTypeProfile {
    +SK~PersonalityType~ type
    +Nickname nickname
    +Blurb blurb
    +ProfileTraitCollection traits
  }

  class PersonalityTypeProfileCollection {
    <<Collection>>
  }

  class ProfileTraitCollection {
    <<Collection>>
  }

  class TraitTypeMapping {
    <<Collection>>
  }

  class TraitType {
    <<ValueObject>>
    +SK~Trait~ trait
    +SK~PersonalityType~ type
  }

  class QuestionId {
    <<ValueObject>>
    +string value
  }

  class AnswerId {
    <<ValueObject>>
    +string value
  }

  class IcebreakerId {
    <<ValueObject>>
    +string value
  }

  class Theme {
    <<ValueObject>>
    +string value
  }

  class QuestionText {
    <<ValueObject>>
    +string value
  }

  class AnswerText {
    <<ValueObject>>
    +string value
  }

  class IcebreakerText {
    <<ValueObject>>
    +string value
  }

  class Nickname {
    <<ValueObject>>
    +string value
  }

  class Blurb {
    <<ValueObject>>
    +string value
  }

  class Trait {
    <<SharedKernel>>
  }

  class PersonalityType {
    <<SharedKernel>>
  }

  class QuestionAuthored {
    <<DomainEvent>>
    +QuestionId questionId
  }

  class IcebreakerAuthored {
    <<DomainEvent>>
    +IcebreakerId icebreakerId
  }

  class PersonalityTypesDefined {
    <<DomainEvent>>
  }

  class CatalogRepository {
    <<Repository>>
    +allQuestions() Question
    +allIcebreakers() Icebreaker
    +personalityTypes() PersonalityTypes
  }

  Question *-- QuestionId : id
  Question *-- Theme : theme
  Question *-- QuestionText : text
  Question *-- AnswerCollection : answers
  AnswerCollection "1" *-- "4" Answer : contains
  Answer *-- AnswerId : id
  Answer *-- AnswerText : text
  Answer --> Trait : trait

  Icebreaker *-- IcebreakerId : id
  Icebreaker *-- Theme : theme
  Icebreaker *-- IcebreakerText : text
  Icebreaker *-- IcebreakerTraitCollection : traits
  IcebreakerTraitCollection "1" o-- "1..3" Trait : contains

  PersonalityTypes *-- TraitTypeMapping : mapping
  PersonalityTypes *-- PersonalityTypeProfileCollection : profiles
  TraitTypeMapping "1" o-- "33" TraitType : contains
  TraitType --> Trait : trait
  TraitType --> PersonalityType : type
  PersonalityTypeProfileCollection "1" *-- "4" PersonalityTypeProfile : contains
  PersonalityTypeProfile --> PersonalityType : type
  PersonalityTypeProfile *-- Nickname : nickname
  PersonalityTypeProfile *-- Blurb : blurb
  PersonalityTypeProfile *-- ProfileTraitCollection : traits
  ProfileTraitCollection "1" o-- "3" Trait : contains

  Question ..> QuestionAuthored : emits
  Icebreaker ..> IcebreakerAuthored : emits
  PersonalityTypes ..> PersonalityTypesDefined : emits

  CatalogRepository ..> Question : returns
  CatalogRepository ..> Icebreaker : returns
  CatalogRepository ..> PersonalityTypes : returns
